{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"steps": [
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/test-mail.php",
			"data": "<?php\n// Test sites: pretend every email sends.\nadd_filter( 'pre_wp_mail', '__return_true' );\n"
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"VOICEBOARD_IP_PER_MIN": 100000,
				"VOICEBOARD_NEW_PER_HOUR": 100000
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "voiceboard/voiceboard.php"
		},
		{
			"step": "activateTheme",
			"themeFolderName": "voiceboard-site"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"voiceboard_path": ""
			}
		}
	]
}
