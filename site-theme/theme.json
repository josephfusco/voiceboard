{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#171a20"
				},
				{
					"slug": "accent-1",
					"name": "Blue",
					"color": "#5b84f0"
				},
				{
					"slug": "accent-2",
					"name": "Muted",
					"color": "#a2a6ad"
				},
				{
					"slug": "accent-3",
					"name": "Surface",
					"color": "#1f2228"
				},
				{
					"slug": "accent-4",
					"name": "Line",
					"color": "#2e323a"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.1875rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.1875rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.3125rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Huge",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3rem"
					}
				}
			]
		},
		"layout": {
			"contentSize": "40rem",
			"wideSize": "64rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--contrast)",
			"text": "var(--wp--preset--color--base)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.65",
			"letterSpacing": "-0.003em"
		},
		"spacing": {
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system)",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "-0.015em"
				},
				"color": {
					"text": "var(--wp--preset--color--base)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.08",
					"letterSpacing": "-0.025em",
					"fontWeight": "600"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3",
					"letterSpacing": "-0.01em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-1)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent-1)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"spacing": {
					"padding": {
						"top": "0.6rem",
						"bottom": "0.6rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontWeight": "600",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.08",
					"letterSpacing": "-0.025em",
					"fontWeight": "600"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--accent-3)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "8px",
					"color": "var(--wp--preset--color--accent-4)",
					"width": "1px",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"top": "1.25rem",
						"bottom": "1.25rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "0.875rem",
					"lineHeight": "1.7"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5"
				}
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "1.25em"
					}
				}
			}
		},
		"css": "body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility;font-kerning:normal;font-feature-settings:'kern','liga','calt'}::selection{background:var(--wp--preset--color--accent-1);color:var(--wp--preset--color--base)}h1,h2,h3,h4,.wp-block-post-title{text-wrap:balance}p,li,td{text-wrap:pretty;hanging-punctuation:first}.wp-block-post-content>h2{margin-block-start:3.25rem;margin-block-end:0}.wp-block-post-content>h3{margin-block-start:2.25rem;margin-block-end:0}.wp-block-post-content>h2+*,.wp-block-post-content>h3+*{margin-block-start:0.75rem}.wp-block-post-content>h2+h3{margin-block-start:1.5rem}.wp-block-post-content li+li{margin-block-start:0.5rem}.wp-block-post-content a:where(:not(.wp-element-button)){font-size:inherit;text-decoration-thickness:1px;text-underline-offset:0.2em;text-decoration-color:color-mix(in srgb,currentColor 45%,transparent)}.wp-block-post-content a:where(:not(.wp-element-button)):hover{text-decoration-color:currentColor}:not(pre)>code{font-family:var(--wp--preset--font-family--mono);font-size:0.85em;padding:0.1em 0.35em;border-radius:4px;background:var(--wp--preset--color--accent-3);border:1px solid var(--wp--preset--color--accent-4)}pre code{background:none;border:0;padding:0;font-size:inherit}.wp-block-code{overflow-x:auto}.wp-block-post-content .wp-block-table table{border-collapse:collapse;width:100%;border:0;font-variant-numeric:tabular-nums}.wp-block-post-content .wp-block-table thead{border:0}.wp-block-post-content .wp-block-table th,.wp-block-post-content .wp-block-table td{border:0;border-bottom:1px solid var(--wp--preset--color--accent-4);padding:0.8em 1.25em 0.8em 0;text-align:left;vertical-align:top}.wp-block-post-content .wp-block-table th{color:var(--wp--preset--color--accent-2);font-weight:600;font-size:0.75rem;letter-spacing:0.08em;text-transform:uppercase;border-bottom-color:var(--wp--preset--color--accent-2)}.wp-block-post-content .wp-block-table td:first-child{font-weight:600;white-space:nowrap}"
	}
}
